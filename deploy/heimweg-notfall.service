[Unit]
Description=Heimweg Notfall-Seite (nur Unix-Socket, von aussen nur ueber den Webserver)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heimweg
Group=heimweg
RuntimeDirectory=heimweg
RuntimeDirectoryMode=0755
EnvironmentFile=/etc/heimweg.env
ExecStart=/opt/heimweg/.venv/bin/uvicorn heimweg.notfall:app --uds /run/heimweg/notfall.sock --no-access-log --no-proxy-headers --no-server-header
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Nach draussen ja, an andere Dienste auf dieser Maschine nicht. 127.0.0.53 ist die Namensaufloesung.
IPAddressDeny=localhost
IPAddressAllow=127.0.0.53
MemoryMax=200M

[Install]
WantedBy=multi-user.target
